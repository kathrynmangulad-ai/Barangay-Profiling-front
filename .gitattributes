# Normalize line endings: let Git decide text vs binary, store LF in the repo.
* text=auto

# Explicit text types
*.php   text
*.js    text
*.css   text
*.sql   text
*.md    text
*.html  text
*.json  text
*.htaccess text
*.env    text

# Binary assets (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
