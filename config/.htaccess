# Deny all direct web access to this directory.
# These files are included by PHP from elsewhere and must never be served
# or listed over HTTP (they hold configuration and secrets).

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and earlier
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
