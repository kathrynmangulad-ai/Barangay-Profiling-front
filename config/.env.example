# Barangay System environment configuration.
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env   (or copy it in your file explorer)
# The .env file is gitignored so your secrets never get committed.

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=brgy_system

# --- Mail (SMTP) ----------------------------------------------------------
# For Brevo: MAIL_USER is the SMTP login, MAIL_PASS is the SMTP key.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-smtp-login
MAIL_PASS=your-smtp-key
MAIL_FROM=verified-sender@example.com
MAIL_FROM_NAME=Barangay System

# --- Application ----------------------------------------------------------
APP_BASE_URL=http://localhost/barangay_system
APP_TIMEZONE=Asia/Manila
